# Copy to .env (or .env.local) and fill in. Only client-safe (publishable) keys may use NEXT_PUBLIC_.

# ---- Database (REQUIRED) — plain Postgres connection used by drizzle + `npm run db:migrate`
# Supabase Dashboard → Connect → "Session pooler" (port 5432). Do NOT use the transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# optional: pool size for the app (default 5)
# DB_POOL_MAX=5

# ---- Supabase Storage (job attachments / payment slips) — server-only secret key
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# bucket name (created automatically on first upload, default: attachments)
# SUPABASE_STORAGE_BUCKET=attachments
# the publishable key is no longer needed by the app (all data goes through DATABASE_URL)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Central SSO (server-only)
# CENTRAL_API_KEY authorizes the directory lookup and signs the session cookie.
CENTRAL_API_KEY=
SSO_CLIENT_ID=cli_168eb7414da1a2e2
SSO_CLIENT_SECRET=
SESSION_SECRET=

# Emails that are ALWAYS System Admin (comma-separated) — bootstrap so the owner
# is never locked out. Optional; project owners are also built in as a fallback.
OWNER_EMAILS=
