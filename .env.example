# Copy to .env.local and fill in. Only client-safe (publishable) keys belong here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER-ONLY secret (no NEXT_PUBLIC_ prefix) — central API key (directory + SSO verify).
# It must never be sent to the browser.
CENTRAL_API_KEY=

# Supabase SECRET key — server-only (writes bypass RLS). Never use NEXT_PUBLIC_ for this.
SUPABASE_SECRET_KEY=

# Central SSO (server-only)
SSO_CLIENT_ID=cli_168eb7414da1a2e2
SSO_CLIENT_SECRET=
SESSION_SECRET=

# Emails that are ALWAYS System Admin (comma-separated) — bootstrap so the owner
# is never locked out. Optional; project owners are also built in as a fallback.
OWNER_EMAILS=
