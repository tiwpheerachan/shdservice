# Production variables — set on Render (Environment). The copy on this machine for production-only commands is
# .env.prod.local (never .env: Next.js would load it into npm run dev). Dev: .env.development.example.
# Only client-safe (publishable) keys may use NEXT_PUBLIC_.

# ---- Database (REQUIRED) — plain Postgres connection used by drizzle + `npm run db:migrate`
# Supabase Dashboard → Connect → "Session pooler" (port 5432). Do NOT use the transaction pooler (6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# optional (recommended in production): verify the pooler's TLS certificate (src/db/ssl.ts).
# Unset = encrypted but the server certificate is NOT verified (MITM-able). Set = verified, and a
# wrong CA makes every DB connection fail — check the app + `db:migrate` deploy log after setting it.
# Value: Supabase's own root "Supabase Root 2021 CA" (prod-ca-2021.crt, valid until 2031-04-26,
# sha256 80:70:25:AD:50:D4:ED:21:9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA)
# from Dashboard → Database → SSL Configuration → Download certificate, or
# https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt
# Node's default CA store does NOT trust it, so it cannot be left out. Paste the whole PEM
# (multi-line, or one line with literal \n). No ?sslmode=… in DATABASE_URL: pg lets it override this.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIDxDCC…\n-----END CERTIFICATE-----
# optional: pool size for the app (default 5)
# DB_POOL_MAX=5
# `next dev` / `db:migrate` (outside Render) refuse the PRODUCTION project (bnntps…) unless this is 1
# ALLOW_PROD_DB=1

# ---- Supabase Storage (job attachments / payment slips) — server-only secret key
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# bucket name (private; created automatically on first upload, default: oneservice)
# SUPABASE_STORAGE_BUCKET=oneservice
# the publishable key is no longer needed by the app (all data goes through DATABASE_URL)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Cloudflare R2 (job VIDEO attachments only — images / PDFs / slips / logos stay in Supabase) — server-only
# bucket (prod: oneservicevideos — private, APAC); an API token "Object Read & Write" scoped to that bucket only.
# Unset → the video API answers 503 and the attach box offers no video; everything else works.
# The endpoint is https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com (also allowed by the CSP, src/proxy.ts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oneservicevideos
# optional: play R2 videos (and their thumbnails) through the media Worker + Cloudflare's edge cache
# (workers/media, manual: docs/cloudflare-cdn.md). Both set → /api/files redirects to MEDIA_BASE_URL with a link
# signed by MEDIA_SIGNING_KEY (the same value as the Worker's secret; openssl rand -hex 32); unset → presigned R2
# URLs as before. Rollback = unset both. MEDIA_BASE_URL is an https origin, no path (also allowed by the CSP).
MEDIA_BASE_URL=
MEDIA_SIGNING_KEY=

# ---- Central SSO (server-only)
# CENTRAL_API_KEY authorizes the directory lookup (it no longer signs sessions).
CENTRAL_API_KEY=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# SSO_ORIGIN=https://sso.shd-technology.co.th  (default; only the e2e tests point it at their fake SSO)
# Session-cookie signing key — REQUIRED in production (openssl rand -hex 32, at least 32 chars)
SESSION_SECRET=
# SSO_DEBUG=shape logs the STRUCTURE of the /sso/verify answer on each sign-in (field names,
# types, string lengths — never a value). Safe in production; switch it off again afterwards.
# SSO_DEBUG=shape
# Central single logout at session renewal: off | log (default — ask SSO, log, sign nobody out) | enforce
# SSO_SESSION_CHECK=log

# Emails that become System Admin while their user row has no role yet (comma-separated) —
# bootstrap for a fresh database. An admin can change or disable them later.
# REQUIRED in production (the built-in project owners apply to dev/test databases only).
OWNER_EMAILS=

# ---- Public tracking (/track) — Turnstile → one-time ticket (drizzle/0014, app/api/track/*)
# Public base URL (the Cloudflare subdomain): customer links + the Turnstile hostname check
APP_BASE_URL=http://localhost:3000
# Cloudflare Turnstile (production widget mode: Invisible). Local dev: Cloudflare's test keys —
#   site 1x00000000000000000000BB (invisible) or 1x00000000000000000000AA (visible), both always pass
#   secret 1x0000000000000000000000000000000AA (always passes)
# Test keys are refused in production. No keys = tracking closed (fail-closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# optional: hostname Siteverify must report (defaults to the host of APP_BASE_URL)
# TURNSTILE_EXPECTED_HOSTNAME=
# Origin protection: Cloudflare adds X-Origin-Auth=<secret> (Transform Rule). off | log | enforce
# (default: enforce in production, off in dev)
ORIGIN_AUTH_SECRET=
# ORIGIN_AUTH_MODE=off
# HMAC key for IPs / links in the tracking security log and rate-limit keys
TRACK_LOG_SECRET=

# ---- /track phone + SMS OTP (src/server/sms.ts)
# SMS_PROVIDER = thaibulksms | log   (unset: thaibulksms when both keys are set, otherwise log)
# log = no SMS, the OTP is printed to the server log as "[sms:log] to 08…: …" — development only,
# refused in production (the page then says the OTP service is not open yet).
SMS_PROVIDER=log
# ThaiBulkSMS OTP service → OTP Manager → the app's key / secret (NOT Setting → API Key, which is the
# plain SMS API). The app must be set to a 4-digit code (OTP_LENGTH) that lasts 5 minutes (the /track page says so).
THAIBULKSMS_OTP_KEY=
THAIBULKSMS_OTP_SECRET=

# ---- Runtime (production)
# process clock in Thai time — file names and local times; the startup env check warns without it
# TZ=Asia/Bangkok
# 1 = a production start with missing/invalid config (src/server/env.ts) exits instead of only warning
# ENV_STRICT=0
