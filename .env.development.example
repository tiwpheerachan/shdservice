# Copy to .env.development.local (gitignored) — `npm run dev` reads it AFTER .env and it wins.
# .env holds PRODUCTION values; everything that must not touch production is overridden here.

# Local dev database (docker-compose.yml): npm run db:dev:up && npm run db:dev:load
DATABASE_URL=postgresql://root:dev_pass@127.0.0.1:55435/oneservice_dev_db
# No Storage in dev — .env's keys are the PRODUCTION bucket. Uploads answer "not configured".
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile TEST keys — always pass on localhost, refused in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# OTP printed in the terminal instead of a real SMS
SMS_PROVIDER=log
# SSO returns to localhost when you sign in from npm run dev
APP_BASE_URL=http://localhost:3000
