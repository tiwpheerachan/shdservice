# Copy to .env.development.local (git-ignored) and fill in — the ONLY env file `npm run dev` needs.
# Keep every variable here: Next.js also loads a file named .env, so there must be no .env in this folder.
# Production values live on Render (Environment); the copy on this machine for production-only commands
# (db:prod:migrate, db:seed:export, setupdata/cutover.sh) is .env.prod.local — a name Next.js never loads.

# ---- Database: the local dev database (docker-compose.yml): npm run db:dev:up && npm run db:dev:load
DATABASE_URL=postgresql://root:dev_pass@127.0.0.1:55435/shd_oneservice_dev_db
# DB_POOL_MAX=5

# ---- Sign-in (SHD SSO)
# Session-cookie signing key for dev only — any random value, NOT production's (openssl rand -hex 32)
SESSION_SECRET=
# The SSO client the app signs in with. Ask the SSO admin for a dev client whose redirect allows
# http://localhost:3000/api/sso/callback (or reuse the app's client if it already allows localhost).
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# directory lookup (staff search / profile); empty = sign-in still works, no directory profile
CENTRAL_API_KEY=
# SSO_ORIGIN=https://sso.shd-technology.co.th   (default)
# Offline alternative: the e2e fake SSO — `npx tsx tests/e2e/support/fake-sso.ts` (see tests/e2e/support/env.ts
# for its port / client id / secret) and point SSO_ORIGIN, SSO_CLIENT_ID, SSO_CLIENT_SECRET, CENTRAL_API_KEY at it.
# SSO_SESSION_CHECK=off
# Always System Admin in dev (comma-separated e-mails) — src/lib/access.ts has no built-in list
OWNER_EMAILS=
# Where SSO returns after sign-in, and the base of customer tracking links
APP_BASE_URL=http://localhost:3000

# ---- Storage: none in dev (production's keys are the PRODUCTION bucket). Uploads answer "not configured".
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=oneservice
# Videos (R2) off in dev: the video attach box is hidden. A dev bucket + token would go here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# media Worker off in dev (videos would use presigned R2 links)
MEDIA_BASE_URL=
MEDIA_SIGNING_KEY=

# ---- Public tracking (/track)
# Cloudflare Turnstile TEST keys — always pass on localhost, refused in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HMAC key for IPs / links in the tracking log — any random dev value
TRACK_LOG_SECRET=
# Origin protection is off in dev (no Cloudflare in front of localhost)
ORIGIN_AUTH_SECRET=
# ORIGIN_AUTH_MODE=off
# OTP printed in the terminal instead of a real SMS
SMS_PROVIDER=log
THAIBULKSMS_OTP_KEY=
THAIBULKSMS_OTP_SECRET=

# ---- Runtime
TZ=Asia/Bangkok
# RATE_LIMIT_SCALE=   e2e only (tests/e2e/support/env.ts) — multiplies every per-user rate limit; never on Render
