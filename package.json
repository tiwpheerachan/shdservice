{
  "name": "shd-service-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run docs:api && next build",
    "docs:api": "tsx scripts/build-api-docs.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:reset": "tsx scripts/migrate.ts --reset",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "files:validate": "tsx scripts/legacy-files.mts validate",
    "files:upload": "tsx scripts/legacy-files.mts upload all",
    "test:schemas": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-schemas.mts",
    "test:auth": "tsx scripts/test-auth.mts",
    "test:running-no": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-running-no.mts",
    "test:track": "API_CONTRACT_STRICT=1 NODE_OPTIONS=--conditions=react-server tsx scripts/test-track.mts",
    "test:rate-limit": "tsx scripts/test-rate-limit.mts",
    "test": "npm run -s test:schemas && npm run -s test:auth && npm run -s test:rate-limit && npm run -s test:openapi && npm run -s test:routes-input",
    "test:db": "npm run -s test:running-no && npm run -s test:track && npm run -s test:domain && npm run -s test:api",
    "e2e": "playwright test",
    "db:test:up": "docker compose -f tests/docker-compose.yml -p oneservice-test up -d --wait",
    "db:test:down": "docker compose -f tests/docker-compose.yml -p oneservice-test down",
    "db:test:prepare": "tsx tests/prepare-db.mts",
    "db:dev:up": "docker compose -f docker-compose.yml up -d --wait",
    "db:dev:load": "tsx scripts/dev-db.mts",
    "db:dev:migrate": "DATABASE_URL=postgresql://root:dev_pass@127.0.0.1:55435/shd_oneservice_dev_db tsx scripts/migrate.ts",
    "test:domain": "API_CONTRACT_STRICT=1 NODE_OPTIONS=--conditions=react-server tsx scripts/test-domain.mts",
    "db:dev:down": "docker compose -f docker-compose.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:openapi": "tsx scripts/test-openapi.mts",
    "test:routes-input": "tsx scripts/test-routes-input.mts",
    "test:api": "API_CONTRACT_STRICT=1 NODE_OPTIONS=--conditions=react-server tsx scripts/test-api.mts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@supabase/supabase-js": "2.58.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "lru-cache": "11.5.3",
    "lucide-react": "0.469.0",
    "next": "16.3.8",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hrefcl/apidoc": "5.1.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dompurify": "3.4.16",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@hrefcl/apidoc": {
      "puppeteer": "25.14.0",
      "@tailwindcss/typography": {
        "postcss-selector-parser": "7.1.6"
      }
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
